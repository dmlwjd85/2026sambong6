rules_version = '2';
// sambong-world-2026 단일 Firestore — 삼봉 월드(artifacts) + ncgame(loginByName, users) 통합 규칙
// Firebase 콘솔 → Firestore → 규칙에 붙여넣거나: firebase deploy --only firestore

service cloud.firestore {
  match /databases/{database}/documents {
    // --- 삼봉 월드 (sambongWorld.js) ---
    function signedIn() {
      return request.auth != null;
    }

    // 마스터 PIN 로그인은 익명 Firebase 인증입니다.
    // Google 로그인이나 admins/{uid} 는 보지 않습니다. 로그인한 세션이면 형식이 맞을 때 씁니다.
    // PIN 대조는 브라우저에서만 하므로, 학생 익명 세션도 같은 쓰기 규칙을 탑니다.
    // 스킨 구매 시각(request.time)은 여기서 보지 않습니다. 가격표는 앱에만 있고
    // 규칙에는 반올림이 없으며, 학생 문서는 퀘스트·은행·선생님 복구가 한 번에 덮입니다.
    // {document=**} 는 path 라서 문자열과 바로 비교하지 않습니다.

    function isSettingsGlobalDoc() {
      return string(request.path).matches('^/databases/[^/]+/documents/artifacts/[^/]+/public/data/settings/global$');
    }

    function isAutoXpDoc() {
      return string(request.path).matches('^/databases/[^/]+/documents/artifacts/[^/]+/public/data/settings/autoXp$');
    }

    function isLearningThermometerDoc() {
      return string(request.path).matches('^/databases/[^/]+/documents/artifacts/[^/]+/public/data/settings/learningThermometer$');
    }

    function isLearningThermometerVoteDoc() {
      return string(request.path).matches('^/databases/[^/]+/documents/artifacts/[^/]+/public/data/settings/learningThermometer/votes/[^/]+$');
    }

    function isApprovedClassIdDoc() {
      return string(request.path).matches('^/databases/[^/]+/documents/artifacts/sambong-class-2026/public/data/approvedClassIds/[^/]+$');
    }

    function isStudentDoc() {
      return string(request.path).matches('^/databases/[^/]+/documents/artifacts/[^/]+/public/data/students/[^/]+$');
    }

    // 학생 문서는 공개 와일드카드와 OR 됩니다. 슬롯 키 검사는 이쪽에도 있어야 우회되지 않습니다.
    function studentClassXpSlotAllowed() {
      return !isStudentDoc()
        || request.method == 'delete'
        || (request.method == 'create' && !('lastClassXpSlot' in request.resource.data))
        || (request.method == 'update' && classXpSlotWriteOk());
    }

    // 선생님 화면이 주로 쓰는 키 목록입니다. 권한으로 막지는 않고, 할인 형식처럼
    // 따로 검사하는 필드만 규칙을 탑니다. 목록은 앱의 GM_ONLY_SETTING_KEYS 와 맞춥니다.
    function gmOnlyKeys() {
      return [
        'shopPrices',
        'customShopItems',
        'convenienceItems',
        'customQuests',
        'deletedQuestIds',
        'customJobs',
        'jobOverrides',
        'deletedJobIds',
        'worldSettings',
        'raidPassword',
        'weekendRaidRewardXp',
        'weekendRaidRewardBong',
        'constitutionItems',
        'bankInterestPercent',
        'bankLoanLimitPerStudent',
        'bankTransferFeeBong',
        'dragonBallFindXp',
        'dragonBallFindBong',
        'dragonBallCompleteXp',
        'dragonBallCompleteBong',
        'convenienceDeliveryFee',
        'announcement',
        'morningActivityNotice',
        'screenNotice',
        'classTimetable',
        'birthdayCelebrations',
        'classModules',
        'externalPortals',
        'weatherRegion',
        'classToolShare',
        'researchJournal',
        'researchSurveyUrl',
        'researchSurveyNote',
        'classWatchOn',
        'curriculumTags',
        'curriculumMapping',
        'applyDefaultTemplatePending',
        'season2StartedAt',
        'season2StartedBy',
        'season2WeaponsClearedAt',
        'season2DragonBallsClearedAt',
        'shieldStockFixedTo5At',
        'season1ItemsRefundedAt',
        'raidPasswordNeedsSetup',
        'learningThermometer'
      ];
    }

    function twoDigits(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    // slotMs를 UTC epoch로 읽은 뒤 9시간을 더하면, hours()/minutes()가 한국 표준시 벽시계가 됩니다.
    function autoXpKst(slotMs) {
      return timestamp.value(slotMs) + duration.value(9, 'h');
    }

    function autoXpIsClassEnd(slotMs) {
      let kst = autoXpKst(slotMs);
      return kst.seconds() == 0
        && kst.nanos() == 0
        && (
          (kst.hours() == 9 && kst.minutes() == 40)
          || (kst.hours() == 10 && kst.minutes() == 30)
          || (kst.hours() == 11 && kst.minutes() == 20)
          || (kst.hours() == 12 && kst.minutes() == 10)
          || (kst.hours() == 13 && kst.minutes() == 50)
          || (kst.hours() == 14 && kst.minutes() == 40)
        );
    }

    function autoXpKey(slotMs) {
      let kst = autoXpKst(slotMs);
      return string(kst.year()) + '_' + twoDigits(kst.month()) + '_' + twoDigits(kst.day())
        + '_' + twoDigits(kst.hours()) + ':' + twoDigits(kst.minutes());
    }

    function kstNow() {
      return request.time + duration.value(9, 'h');
    }

    // 1970-01-01은 목요일. date()는 9시간을 더한 시각의 달력 날짜(한국 표준시)입니다.
    // 0=일요일 … 6=토요일. rules에 weekday()가 없어 epoch 일로 계산합니다.
    function kstWeekdaySunday0() {
      return (math.floor(kstNow().date().toMillis() / 86400000) + 4) % 7;
    }

    // 오늘 이미 지난 종 가운데 가장 최근 시각. 09:40 이전이면 빈 문자열입니다.
    function classXpCatchupClock() {
      let mins = kstNow().hours() * 60 + kstNow().minutes();
      return mins >= 880 ? '14:40'
        : mins >= 830 ? '13:50'
        : mins >= 730 ? '12:10'
        : mins >= 680 ? '11:20'
        : mins >= 630 ? '10:30'
        : mins >= 580 ? '09:40'
        : '';
    }

    // 평일에만, 오늘 가장 최근 종 키. 주말·첫 종 이전은 빈 문자열이라 지급이 거부됩니다.
    // 다음 종 전까지 그 키만 허용하므로, 놓친 이전 종을 한꺼번에 받지 못합니다.
    function classXpCatchupKeyNow() {
      let clock = classXpCatchupClock();
      let kst = kstNow();
      let weekday = kstWeekdaySunday0();
      return clock != '' && weekday >= 1 && weekday <= 5
        ? string(kst.year()) + '_' + twoDigits(kst.month()) + '_' + twoDigits(kst.day()) + '_' + clock
        : '';
    }

    // 공지 문장은 저장하지 않습니다. 앱이 slotMs로 만듭니다.
    // autoXp는 공지용입니다. 지급 여부는 학생 문서 lastClassXpSlot이 정합니다.
    // 키는 오늘 가장 최근 종(이미 지난 것, 그 1분이 지난 뒤 포함)과 같아야 합니다.
    function autoXpShapeOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(['lastAutoXpTime', 'slotMs'])
        && d.lastAutoXpTime is string
        && d.slotMs is int
        && d.slotMs > 1577836800000
        && d.slotMs < 4102444800000
        && d.slotMs % 60000 == 0
        && d.slotMs <= request.time.toMillis() + 15000
        && autoXpIsClassEnd(d.slotMs)
        && d.lastAutoXpTime == autoXpKey(d.slotMs)
        && d.lastAutoXpTime == classXpCatchupKeyNow();
    }

    // 슬롯 키는 오늘 가장 최근 종에 경험치가 정확히 +5일 때만 바꿉니다.
    // xp가 숫자가 아니면 이 분기는 거부됩니다. 지우기는 경험치를 0으로 되돌리는 초기화에서만 됩니다.
    function classXpSlotWriteOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['lastClassXpSlot'])
        || (
          classXpCatchupKeyNow() != ''
          && request.resource.data.lastClassXpSlot is string
          && request.resource.data.lastClassXpSlot == classXpCatchupKeyNow()
          && request.resource.data.xp is number
          && resource.data.xp is number
          && request.resource.data.xp == resource.data.xp + 5
        )
        || (
          request.resource.data.xp is number
          && request.resource.data.xp == 0
          && (
            !('lastClassXpSlot' in request.resource.data)
            || request.resource.data.lastClassXpSlot == ''
          )
        );
    }

    // 잠금 소유자·시도 번호·예전 값 표식은 새 클라이언트만 씁니다.
    // 규칙을 먼저 배포해도, 새로고침 전 화면의 저장은 이 필드 없이 통과합니다.
    // 필드가 있을 때만 형식을 검사합니다.
    function thermometerOptionalFieldsOk(d) {
      return (!('settlementLockOwner' in d) || (
          d.settlementLockOwner is string
          && d.settlementLockOwner.size() <= 80
        ))
        && (!('settlementAttempt' in d) || (
          d.settlementAttempt is int
          && d.settlementAttempt >= 0
          && d.settlementAttempt <= 1000000
        ))
        && (!('usedStaleValues' in d) || d.usedStaleValues is bool);
    }

    function thermometerShapeOk() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'date', 'min', 'max', 'settledDate', 'lastSettlementAt',
          'settlementKey', 'settlementStatus', 'settlementStartedAt',
          'settlementLockOwner', 'settlementAttempt', 'usedStaleValues',
          'settlementAppliedCount', 'settlementTotalDelta'
        ])
        && d.date is string
        && d.date.size() >= 8
        && d.date.size() <= 10
        && d.min is int
        && d.min >= -500
        && d.min < 0
        && d.max is int
        && d.max > 0
        && d.max <= 500
        && d.min < d.max
        && d.settledDate is string
        && d.settledDate.size() <= 10
        && d.lastSettlementAt is number
        && d.settlementKey is string
        && d.settlementKey.size() <= 12
        && d.settlementStatus is string
        && d.settlementStatus.size() <= 20
        && d.settlementStartedAt is number
        && thermometerOptionalFieldsOk(d)
        && d.settlementAppliedCount is int
        && d.settlementAppliedCount >= 0
        && d.settlementAppliedCount <= 40
        && d.settlementTotalDelta is int
        && d.settlementTotalDelta >= -20000
        && d.settlementTotalDelta <= 20000;
    }

    function thermometerVoteInRange(appId, value) {
      let parent = get(/databases/$(database)/documents/artifacts/$(appId)/public/data/settings/learningThermometer).data;
      return parent.min is int
        && parent.max is int
        && value >= parent.min
        && value <= parent.max;
    }

    function thermometerVoteOk(appId, studentId) {
      let d = request.resource.data;
      return studentId.matches('^[A-Za-z0-9_-]{1,24}$')
        && d.keys().hasOnly(['value'])
        && d.value is int
        && exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/settings/learningThermometer)
        && thermometerVoteInRange(appId, d.value);
    }

    function shopDiscountUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['shopDiscount']);
    }

    function gmOnlyUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(gmOnlyKeys());
    }

    function createHasShopDiscount() {
      return 'shopDiscount' in request.resource.data;
    }

    function createTouchesGmOnly() {
      return request.resource.data.keys().hasAny(gmOnlyKeys());
    }

    function shopDiscountChangeIsValid() {
      let d = request.resource.data.shopDiscount;
      return d is map
        && d.keys().hasAll(['enabled', 'percent'])
        && d.enabled is bool
        && d.percent is int
        && d.percent >= 0
        && d.percent <= 100
        && (
          d.enabled == false
          || (
            d.keys().hasAll(['startAt', 'endAt'])
            && d.startAt is number
            && d.endAt is number
            && d.startAt < d.endAt
          )
        );
    }

    function studentCreateIsSafe() {
      return signedIn()
        && request.resource.data.xp is number
        && request.resource.data.bong is number
        && request.resource.data.xp >= 0
        && request.resource.data.bong >= -2000
        && !('lastClassXpSlot' in request.resource.data);
    }

    function studentUpdateIsSafe() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return signedIn()
        // XP: 하락(마스터 수정·차감) 허용, 1회 저장 상승은 650 이하(비정상 급등 방지)
        && (!changed.hasAny(['xp']) || (
          request.resource.data.xp is number
          && request.resource.data.xp >= 0
          && (
            request.resource.data.xp <= resource.data.xp
            || request.resource.data.xp <= resource.data.xp + 650
          )
        ))
          // 봉은 정상 구매/점심 차감·계좌이체(최대 5000+수수료)·대출 자동이체를 허용하고, 오래 열린 창의 큰 마이너스 덮어쓰기는 차단합니다.
          && (!changed.hasAny(['bong'])
            || request.resource.data.bong >= resource.data.bong
            || (
              request.resource.data.bong >= -2000
              && request.resource.data.bong >= resource.data.bong - 5050
            ))
          && classXpSlotWriteOk();
    }

    match /artifacts/{appId}/public/data/students/{studentId} {
      allow read: if true;
      allow create: if studentCreateIsSafe();
      allow update: if studentUpdateIsSafe();
      allow delete: if false;
    }

    // 보드게임 방: 로그인(익명 인증)한 학급 화면에서만 만들고 고칩니다.
    // 학번·방장 권한은 클라이언트 상태 머신(boardGameRooms.js)이 검사합니다.
    // 익명 Auth에는 학번이 없으므로 규칙에서 명단 대조는 하지 않습니다.
    match /artifacts/{appId}/public/data/boardGameRooms/{roomId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.gameType is string
        && request.resource.data.hostId is string
        && request.resource.data.status is string;
      allow update: if signedIn();
      allow delete: if signedIn();
    }

    // 공개 와일드카드와 OR 되므로, 이 문서의 쓰기는 여기서만 허용합니다.
    // 로그인한 세션(마스터 PIN 익명 포함)이면 만들고 고칩니다.
    // 할인이 있으면 형식만 검사합니다. 앱은 이 문서를 지우지 않습니다.
    match /artifacts/{appId}/public/data/settings/global {
      allow read: if true;
      allow create: if signedIn()
        && (!createHasShopDiscount() || shopDiscountChangeIsValid());
      allow update: if signedIn()
        && (shopDiscountUntouched() || shopDiscountChangeIsValid());
      allow delete: if false;
    }

    // 수업 종료 자동 XP 공지. 지급 중복 방지는 학생 문서 lastClassXpSlot입니다.
    match /artifacts/{appId}/public/data/settings/autoXp {
      allow read: if true;
      allow create: if signedIn() && autoXpShapeOk();
      allow update: if signedIn()
        && autoXpShapeOk()
        && resource.data.slotMs is int
        && request.resource.data.slotMs >= resource.data.slotMs + 2400000;
      allow delete: if false;
    }

    // 학습 온도계 부모. 로그인한 세션이 형식을 지키면 만들고 고칩니다. 학생별 값은 votes 하위 문서입니다.
    match /artifacts/{appId}/public/data/settings/learningThermometer {
      allow read: if true;
      allow create: if signedIn() && thermometerShapeOk();
      allow update: if signedIn() && thermometerShapeOk();
      allow delete: if false;
    }

    // 학번 문서를 마스터 PIN(익명 uid)도 쓸 수 있게, 문서 ID와 uid가 달라도 형식만 맞으면 허용합니다.
    match /artifacts/{appId}/public/data/settings/learningThermometer/votes/{studentId} {
      allow read: if true;
      allow create, update: if signedIn() && thermometerVoteOk(appId, studentId);
      allow delete: if false;
    }

    // 학급 개설 표식. 로그인한 세션이 자기 uid를 createdBy에 남기고 필드 형식이 맞을 때만 만듭니다.
    match /artifacts/sambong-class-2026/public/data/approvedClassIds/{classId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['classId', 'status', 'createdBy'])
        && request.resource.data.classId == classId
        && request.resource.data.status == 'approved'
        && request.resource.data.createdBy is string
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    // 예전 허용목록. 저장 권한에는 쓰지 않습니다. 클라이언트는 만들거나 고치지 못합니다.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /artifacts/{appId}/public/{document=**} {
      allow read: if true;
      allow write: if signedIn()
        && !isSettingsGlobalDoc()
        && !isAutoXpDoc()
        && !isLearningThermometerDoc()
        && !isLearningThermometerVoteDoc()
        && !isApprovedClassIdDoc()
        && studentClassXpSlotAllowed();
    }

    match /classes/{classId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 다른 학급 개설 요청(구 최상위 경로). 실제 문서는
    // artifacts/sambong-class-2026/public/data/classCreateRequests 를 씁니다.
    match /classCreateRequests/{requestId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.status == 'pending';
      allow update: if signedIn();
      allow delete: if false;
    }

    // 초대 코드 → classId O(1) 매핑 (학급별 공유 링크 ?c=CODE)
    match /inviteCodes/{code} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['classId'])
        && request.resource.data.classId is string
        && request.resource.data.classId.size() > 0;
      allow update: if signedIn()
        && request.resource.data.classId is string
        && (
          !('classId' in resource.data)
          || request.resource.data.classId == resource.data.classId
        );
      allow delete: if false;
    }

    // --- ncgame ---
    match /loginByName/{name} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    match /ncgameHofByPack/{packId}/entries/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.packId == packId;
      allow delete: if false;
    }

    // --- PicBook / visual_dictionary ---
    // 삼봉월드 UI·코드에서는 제거됨. 동일 Firebase를 쓰는 PicBook 앱이 별도 규칙 파일을
    // 배포하기 전까지는 접근이 끊기지 않도록 규칙만 유지합니다.
    match /picbook_accounts/{accountKey} {
      allow read, write: if request.auth != null;
    }

    match /picbook_published_timelines/{bookId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /visual_dictionary/{wordId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /visual_dictionary_stories/{storyId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
