rules_version = '2';
// sambong-world-2026 단일 Firestore — 삼봉 월드(artifacts) + ncgame(loginByName, users) 통합 규칙
// Firebase 콘솔 → Firestore → 규칙에 붙여넣거나: firebase deploy --only firestore

service cloud.firestore {
  match /databases/{database}/documents {
    // --- 삼봉 월드 (sambongWorld.js) ---
    function signedIn() {
      return request.auth != null;
    }

    // 인증이 없는 요청만 거절합니다.
    // 익명 로그인만 된 클라이언트는 아래 필드 제약 안에서 쓸 수 있습니다.
    // 학생별 uid 명단은 두지 않습니다. 학급 로그인이 기기마다 새 익명 uid를 만들기 때문입니다.
    function canAccessClassData() {
      return signedIn();
    }

    function pad2(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    function salaryYmd(ts) {
      return string(ts.year()) + '_' + pad2(ts.month()) + '_' + pad2(ts.day());
    }

    // 한국 시간 기준 최근 주급 금요일. weeklySalary.js recentSalaryWeekId 와 같습니다.
    function recentSalaryWeekKey() {
      let now = request.time + duration.value(9, 'h');
      let wd = (int(now.toMillis() / 86400000) + 4) % 7;
      let hr = now.hours();
      let inWindow = (wd == 5 && hr >= 15) || wd == 6 || wd == 0;
      let friday = inWindow
        ? (wd == 6
            ? now + duration.value(-1, 'd')
            : (wd == 0 ? now + duration.value(-2, 'd') : now))
        : (wd == 5
            ? now + duration.value(-7, 'd')
            : now + duration.value(-(wd + 2), 'd'));
      return 'SALARY_' + salaryYmd(friday);
    }

    function salaryWeekValueIsRecent() {
      return request.resource.data.salaryPaidWeek is string
        && request.resource.data.salaryPaidWeek.matches('^SALARY_\\d{4}_\\d{2}_\\d{2}$')
        && request.resource.data.salaryPaidWeek == recentSalaryWeekKey();
    }

    // 주급 표식은 최근 키로만 바꿉니다. 비우거나 다른 주로 돌리면 거절합니다.
    function salaryMarkerIsSafe() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['salaryPaidWeek'])
        || salaryWeekValueIsRecent();
    }

    // 주급 표식을 옮기는 쓰기는 봉을 주급 상한(200)까지만 올릴 수 있습니다.
    function salaryPayoutBongIsSafe() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let weekMoved = changed.hasAny(['salaryPaidWeek']);
      let bongMoved = changed.hasAny(['bong']);
      return !weekMoved
        || !bongMoved
        || (
          request.resource.data.bong is number
          && resource.data.bong is number
          && request.resource.data.bong - resource.data.bong <= 200
        );
    }

    function studentCreateIsSafe() {
      return signedIn()
        && request.resource.data.xp is number
        && request.resource.data.bong is number
        && request.resource.data.xp >= 0
        && request.resource.data.bong >= -2000;
    }

    function studentUpdateIsSafe() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return canAccessClassData()
        && salaryMarkerIsSafe()
        && salaryPayoutBongIsSafe()
        // XP: 하락(마스터 수정·차감) 허용, 1회 저장 상승은 650 이하(비정상 급등 방지)
        && (!changed.hasAny(['xp']) || (
          request.resource.data.xp is number
          && request.resource.data.xp >= 0
          && (
            request.resource.data.xp <= resource.data.xp
            || request.resource.data.xp <= resource.data.xp + 650
          )
        ))
          // 봉은 정상 구매/점심 차감·계좌이체(최대 5000+수수료)·대출 자동이체를 허용하고, 오래 열린 창의 큰 마이너스 덮어쓰기는 차단합니다.
          && (!changed.hasAny(['bong'])
            || request.resource.data.bong >= resource.data.bong
            || (
              request.resource.data.bong >= -2000
              && request.resource.data.bong >= resource.data.bong - 5050
            ));
    }

    match /artifacts/{appId}/public/data/students/{studentId} {
      allow read: if canAccessClassData();
      allow create: if studentCreateIsSafe();
      allow update: if studentUpdateIsSafe();
      allow delete: if false;
    }

    // 보드게임 방: 로그인(익명 인증)한 학급 화면에서만 만들고 고칩니다.
    // 학번·방장 권한은 클라이언트 상태 머신(boardGameRooms.js)이 검사합니다.
    // 익명 Auth에는 학번이 없으므로 규칙에서 명단 대조는 하지 않습니다.
    match /artifacts/{appId}/public/data/boardGameRooms/{roomId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.gameType is string
        && request.resource.data.hostId is string
        && request.resource.data.status is string;
      allow update: if signedIn();
      allow delete: if signedIn();
    }

    // 학생 문서는 위 students 규칙만 씁니다.
    // public/{document=**} 와일드카드 update는 학생 경로까지 허용되어 XP 650 상한을 무력화합니다.
    // 재귀 캡처에는 split/matches가 없어, 컬렉션 이름이 students가 아닌 문서만 여기서 씁니다.
    // 읽기는 인증된 요청만 허용합니다. 인증이 없으면 거절합니다.
    match /artifacts/{appId}/public/data/{collection}/{docId} {
      allow read: if canAccessClassData();
      allow create, delete: if canAccessClassData() && collection != 'students';
      allow update: if canAccessClassData()
        && collection != 'students'
        && salaryMarkerIsSafe();
    }

    match /artifacts/{appId}/public/data/{collection}/{docId}/{rest=**} {
      allow read: if canAccessClassData();
      allow create, delete: if canAccessClassData() && collection != 'students';
      allow update: if canAccessClassData()
        && collection != 'students'
        && salaryMarkerIsSafe();
    }

    match /classes/{classId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 다른 학급 개설 요청(구 최상위 경로). 실제 문서는
    // artifacts/sambong-class-2026/public/data/classCreateRequests 를 씁니다.
    match /classCreateRequests/{requestId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.status == 'pending';
      allow update: if signedIn();
      allow delete: if false;
    }

    // 초대 코드 → classId O(1) 매핑 (학급별 공유 링크 ?c=CODE)
    match /inviteCodes/{code} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['classId'])
        && request.resource.data.classId is string
        && request.resource.data.classId.size() > 0;
      allow update: if signedIn()
        && request.resource.data.classId is string
        && (
          !('classId' in resource.data)
          || request.resource.data.classId == resource.data.classId
        );
      allow delete: if false;
    }

    // --- ncgame ---
    match /loginByName/{name} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    match /ncgameHofByPack/{packId}/entries/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.packId == packId;
      allow delete: if false;
    }

    // --- PicBook / visual_dictionary ---
    // 삼봉월드 UI·코드에서는 제거됨. 동일 Firebase를 쓰는 PicBook 앱이 별도 규칙 파일을
    // 배포하기 전까지는 접근이 끊기지 않도록 규칙만 유지합니다.
    match /picbook_accounts/{accountKey} {
      allow read, write: if request.auth != null;
    }

    match /picbook_published_timelines/{bookId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /visual_dictionary/{wordId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /visual_dictionary_stories/{storyId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
