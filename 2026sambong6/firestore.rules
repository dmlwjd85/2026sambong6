rules_version = '2';
// sambong-world-2026 단일 Firestore — 삼봉 월드(artifacts) + ncgame(loginByName, users) 통합 규칙
// Firebase 콘솔 → Firestore → 규칙에 붙여넣거나: firebase deploy --only firestore

service cloud.firestore {
  match /databases/{database}/documents {
    // --- 삼봉 월드 (sambongWorld.js) ---
    function signedIn() {
      return request.auth != null;
    }

    // 선생님 계정은 익명이 아닌 로그인(Google 또는 이메일/비밀번호)이고
    // admins/{uid} 문서가 있을 때만 인정합니다. updatedBy 문자열은 보지 않습니다.
    // 학생 익명 세션은 로또·뮤직타임·방패 재고처럼 학생이 쓰는 키만 바꿀 수 있습니다.
    // 스킨 구매 시각(request.time)은 여기서 보지 않습니다. 가격표는 앱에만 있고
    // 규칙에는 반올림이 없으며, 학생 문서는 퀘스트·은행·선생님 복구가 한 번에 덮입니다.
    // {document=**} 는 path 라서 문자열과 바로 비교하지 않습니다.
    function isAdmin() {
      return signedIn()
        && request.auth.token is map
        && 'firebase' in request.auth.token
        && request.auth.token.firebase is map
        && 'sign_in_provider' in request.auth.token.firebase
        && request.auth.token.firebase.sign_in_provider is string
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function adminRecord() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    // 이미 있는 학급 설정은 admins.classIds 에 그 학급 ID가 있을 때만 고칩니다.
    function isAdminForApp(appId) {
      return isAdmin()
        && adminRecord().classIds is list
        && appId in adminRecord().classIds;
    }

    function hasApprovedClassGrant(classId) {
      return exists(/databases/$(database)/documents/artifacts/sambong-class-2026/public/data/approvedClassIds/$(classId));
    }

    // 새 학급 문서는 그 학급 ID가 classIds에 있거나, 시드 학급 선생님이 남긴 승인 표식이 있을 때만 만듭니다.
    function canCreateClassSettings(appId) {
      return isAdminForApp(appId) || (isAdmin() && hasApprovedClassGrant(appId));
    }

    function isSettingsGlobalDoc() {
      return string(request.path).matches('^/databases/[^/]+/documents/artifacts/[^/]+/public/data/settings/global$');
    }

    function isAutoXpDoc() {
      return string(request.path).matches('^/databases/[^/]+/documents/artifacts/[^/]+/public/data/settings/autoXp$');
    }

    function isLearningThermometerDoc() {
      return string(request.path).matches('^/databases/[^/]+/documents/artifacts/[^/]+/public/data/settings/learningThermometer$');
    }

    function isApprovedClassIdDoc() {
      return string(request.path).matches('^/databases/[^/]+/documents/artifacts/sambong-class-2026/public/data/approvedClassIds/[^/]+$');
    }

    // 학생 화면이 쓰지 않는 것이 확인된 키만 둡니다. 애매한 키는 넣지 않습니다.
    function gmOnlyKeys() {
      return [
        'shopPrices',
        'customShopItems',
        'convenienceItems',
        'customQuests',
        'deletedQuestIds',
        'customJobs',
        'jobOverrides',
        'deletedJobIds',
        'worldSettings',
        'raidPassword',
        'weekendRaidRewardXp',
        'weekendRaidRewardBong',
        'constitutionItems',
        'bankInterestPercent',
        'bankLoanLimitPerStudent',
        'bankTransferFeeBong',
        'dragonBallFindXp',
        'dragonBallFindBong',
        'dragonBallCompleteXp',
        'dragonBallCompleteBong',
        'convenienceDeliveryFee',
        'announcement',
        'morningActivityNotice',
        'screenNotice',
        'classTimetable',
        'birthdayCelebrations',
        'classModules',
        'externalPortals',
        'weatherRegion',
        'classToolShare',
        'researchJournal',
        'researchSurveyUrl',
        'researchSurveyNote',
        'classWatchOn',
        'curriculumTags',
        'curriculumMapping',
        'applyDefaultTemplatePending',
        'season2StartedAt',
        'season2StartedBy',
        'season2WeaponsClearedAt',
        'season2DragonBallsClearedAt',
        'shieldStockFixedTo5At',
        'season1ItemsRefundedAt',
        'raidPasswordNeedsSetup',
        'learningThermometer'
      ];
    }

    function autoXpShapeOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(['lastAutoXpTime', 'announcement', 'slotMs'])
        && d.lastAutoXpTime is string
        && d.lastAutoXpTime.matches('^\\d{4}_\\d{1,2}_\\d{1,2}_(09:40|10:30|11:20|12:10|13:50|14:40)$')
        && d.announcement is string
        && d.announcement.size() > 0
        && d.announcement.size() <= 180
        && d.slotMs is int
        && d.slotMs > 0
        && d.slotMs <= request.time.toMillis() + 180000
        && d.slotMs >= request.time.toMillis() - 180000;
    }

    function thermometerShapeOk() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'date', 'min', 'max', 'values', 'settledDate', 'lastSettlementAt',
          'settlementKey', 'settlementStatus', 'settlementStartedAt',
          'settlementAppliedCount', 'settlementTotalDelta'
        ])
        && d.date is string
        && d.date.size() >= 8
        && d.date.size() <= 10
        && d.min is int
        && d.min >= -500
        && d.min < 0
        && d.max is int
        && d.max > 0
        && d.max <= 500
        && d.min < d.max
        && d.values is map
        && d.values.size() <= 40
        && d.settledDate is string
        && d.settledDate.size() <= 10
        && d.lastSettlementAt is number
        && d.settlementKey is string
        && d.settlementKey.size() <= 12
        && d.settlementStatus is string
        && d.settlementStatus.size() <= 20
        && d.settlementStartedAt is number
        && d.settlementAppliedCount is int
        && d.settlementAppliedCount >= 0
        && d.settlementAppliedCount <= 40
        && d.settlementTotalDelta is int
        && d.settlementTotalDelta >= -20000
        && d.settlementTotalDelta <= 20000;
    }

    function shopDiscountUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['shopDiscount']);
    }

    function gmOnlyUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(gmOnlyKeys());
    }

    function createHasShopDiscount() {
      return 'shopDiscount' in request.resource.data;
    }

    function createTouchesGmOnly() {
      return request.resource.data.keys().hasAny(gmOnlyKeys());
    }

    function shopDiscountChangeIsValid() {
      let d = request.resource.data.shopDiscount;
      return d is map
        && d.keys().hasAll(['enabled', 'percent'])
        && d.enabled is bool
        && d.percent is int
        && d.percent >= 0
        && d.percent <= 100
        && (
          d.enabled == false
          || (
            d.keys().hasAll(['startAt', 'endAt'])
            && d.startAt is number
            && d.endAt is number
            && d.startAt < d.endAt
          )
        );
    }

    function studentCreateIsSafe() {
      return signedIn()
        && request.resource.data.xp is number
        && request.resource.data.bong is number
        && request.resource.data.xp >= 0
        && request.resource.data.bong >= -2000;
    }

    function studentUpdateIsSafe() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return signedIn()
        // XP: 하락(마스터 수정·차감) 허용, 1회 저장 상승은 650 이하(비정상 급등 방지)
        && (!changed.hasAny(['xp']) || (
          request.resource.data.xp is number
          && request.resource.data.xp >= 0
          && (
            request.resource.data.xp <= resource.data.xp
            || request.resource.data.xp <= resource.data.xp + 650
          )
        ))
          // 봉은 정상 구매/점심 차감·계좌이체(최대 5000+수수료)·대출 자동이체를 허용하고, 오래 열린 창의 큰 마이너스 덮어쓰기는 차단합니다.
          && (!changed.hasAny(['bong'])
            || request.resource.data.bong >= resource.data.bong
            || (
              request.resource.data.bong >= -2000
              && request.resource.data.bong >= resource.data.bong - 5050
            ));
    }

    match /artifacts/{appId}/public/data/students/{studentId} {
      allow read: if true;
      allow create: if studentCreateIsSafe();
      allow update: if studentUpdateIsSafe();
      allow delete: if false;
    }

    // 보드게임 방: 로그인(익명 인증)한 학급 화면에서만 만들고 고칩니다.
    // 학번·방장 권한은 클라이언트 상태 머신(boardGameRooms.js)이 검사합니다.
    // 익명 Auth에는 학번이 없으므로 규칙에서 명단 대조는 하지 않습니다.
    match /artifacts/{appId}/public/data/boardGameRooms/{roomId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.gameType is string
        && request.resource.data.hostId is string
        && request.resource.data.status is string;
      allow update: if signedIn();
      allow delete: if signedIn();
    }

    // 공개 와일드카드와 OR 되므로, 이 문서의 쓰기는 여기서만 허용합니다.
    // 생성은 classIds 또는 시드 학급 승인 표식이 있어야 합니다.
    // shopDiscount 와 GM 전용 키를 바꾸려면 학급 관리자입니다. 앱은 이 문서를 지우지 않습니다.
    match /artifacts/{appId}/public/data/settings/global {
      allow read: if true;
      allow create: if canCreateClassSettings(appId)
        && (!createHasShopDiscount() || shopDiscountChangeIsValid());
      allow update: if signedIn() && (
        (shopDiscountUntouched() && gmOnlyUntouched())
        || (
          isAdminForApp(appId)
          && (shopDiscountUntouched() || shopDiscountChangeIsValid())
        )
      );
      allow delete: if false;
    }

    // 수업 종료 자동 XP 표식. 선생님 인증 없이, 시각이 맞고 이전보다 40분 이상 뒤인 슬롯만 기록합니다.
    match /artifacts/{appId}/public/data/settings/autoXp {
      allow read: if true;
      allow create: if signedIn() && autoXpShapeOk();
      allow update: if signedIn()
        && autoXpShapeOk()
        && resource.data.slotMs is int
        && request.resource.data.slotMs >= resource.data.slotMs + 2400000;
      allow delete: if false;
    }

    // 학습 온도계. min/max 와 정산 필드 범위를 검사합니다. values 맵의 개별 숫자는 규칙에서 순회할 수 없습니다.
    match /artifacts/{appId}/public/data/settings/learningThermometer {
      allow read: if true;
      allow create, update: if signedIn() && thermometerShapeOk();
      allow delete: if false;
    }

    // 학급 개설 직전, 시드 학급 선생님만 만듭니다. 요청 문서 ID는 임의라 규칙이 조회하지 못합니다.
    match /artifacts/sambong-class-2026/public/data/approvedClassIds/{classId} {
      allow read: if signedIn();
      allow create: if isAdminForApp('sambong-class-2026')
        && request.resource.data.classId == classId
        && request.resource.data.status == 'approved';
      allow update, delete: if false;
    }

    // 콘솔 또는 Admin SDK 에서만 만듭니다. 클라이언트 쓰기는 막습니다.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /artifacts/{appId}/public/{document=**} {
      allow read: if true;
      allow write: if signedIn()
        && !isSettingsGlobalDoc()
        && !isAutoXpDoc()
        && !isLearningThermometerDoc()
        && !isApprovedClassIdDoc();
    }

    match /classes/{classId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 다른 학급 개설 요청(구 최상위 경로). 실제 문서는
    // artifacts/sambong-class-2026/public/data/classCreateRequests 를 씁니다.
    match /classCreateRequests/{requestId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.status == 'pending';
      allow update: if signedIn();
      allow delete: if false;
    }

    // 초대 코드 → classId O(1) 매핑 (학급별 공유 링크 ?c=CODE)
    match /inviteCodes/{code} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['classId'])
        && request.resource.data.classId is string
        && request.resource.data.classId.size() > 0;
      allow update: if signedIn()
        && request.resource.data.classId is string
        && (
          !('classId' in resource.data)
          || request.resource.data.classId == resource.data.classId
        );
      allow delete: if false;
    }

    // --- ncgame ---
    match /loginByName/{name} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    match /ncgameHofByPack/{packId}/entries/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.packId == packId;
      allow delete: if false;
    }

    // --- PicBook / visual_dictionary ---
    // 삼봉월드 UI·코드에서는 제거됨. 동일 Firebase를 쓰는 PicBook 앱이 별도 규칙 파일을
    // 배포하기 전까지는 접근이 끊기지 않도록 규칙만 유지합니다.
    match /picbook_accounts/{accountKey} {
      allow read, write: if request.auth != null;
    }

    match /picbook_published_timelines/{bookId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /visual_dictionary/{wordId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /visual_dictionary_stories/{storyId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
