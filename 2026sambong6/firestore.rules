rules_version = '2';
// sambong-world-2026 단일 Firestore — 삼봉 월드(artifacts) + ncgame(loginByName, users) 통합 규칙
// Firebase 콘솔 → Firestore → 규칙에 붙여넣거나: firebase deploy --only firestore

service cloud.firestore {
  match /databases/{database}/documents {
    // --- 삼봉 월드 (sambongWorld.js) ---
    function signedIn() {
      return request.auth != null;
    }

    // 선생님 계정은 익명이 아닌 로그인(Google 또는 이메일/비밀번호)이고
    // admins/{uid} 문서가 있을 때만 인정합니다. updatedBy 문자열은 보지 않습니다.
    // 학생 익명 세션은 로또·뮤직타임·방패 재고처럼 학생이 쓰는 키만 바꿀 수 있습니다.
    // 스킨 구매 시각(request.time)은 여기서 보지 않습니다. 가격표는 앱에만 있고
    // 규칙에는 반올림이 없으며, 학생 문서는 퀘스트·은행·선생님 복구가 한 번에 덮입니다.
    // {document=**} 는 path 라서 문자열과 바로 비교하지 않습니다.
    function isAdmin() {
      return signedIn()
        && request.auth.token is map
        && 'firebase' in request.auth.token
        && request.auth.token.firebase is map
        && 'sign_in_provider' in request.auth.token.firebase
        && request.auth.token.firebase.sign_in_provider is string
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function adminRecord() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    // 비밀번호로 들어온 익명 로그인도 그 학급의 마스터 설정을 저장합니다.
    // Google 허용목록은 더 이상 이 저장의 조건이 아닙니다.
    function isAdminForApp(appId) {
      return signedIn() && appId is string;
    }

    function hasApprovedClassGrant(classId) {
      return exists(/databases/$(database)/documents/artifacts/sambong-class-2026/public/data/approvedClassIds/$(classId));
    }

    function approvedClassGrant(classId) {
      return get(/databases/$(database)/documents/artifacts/sambong-class-2026/public/data/approvedClassIds/$(classId)).data;
    }

    // 새 학급 문서는 classIds에 그 ID가 있거나, 시드 학급 선생님이 남긴 승인 표식의 createdBy가
    // 지금 요청한 선생님 uid와 같을 때만 만듭니다.
    function canCreateClassSettings(appId) {
      return isAdminForApp(appId) || (
        isAdmin()
        && hasApprovedClassGrant(appId)
        && approvedClassGrant(appId).createdBy == request.auth.uid
      );
    }

    function isSettingsGlobalDoc() {
      return string(request.path).matches('^/databases/[^/]+/documents/artifacts/[^/]+/public/data/settings/global$');
    }

    function isAutoXpDoc() {
      return string(request.path).matches('^/databases/[^/]+/documents/artifacts/[^/]+/public/data/settings/autoXp$');
    }

    function isLearningThermometerDoc() {
      return string(request.path).matches('^/databases/[^/]+/documents/artifacts/[^/]+/public/data/settings/learningThermometer$');
    }

    function isLearningThermometerVoteDoc() {
      return string(request.path).matches('^/databases/[^/]+/documents/artifacts/[^/]+/public/data/settings/learningThermometer/votes/[^/]+$');
    }

    function isApprovedClassIdDoc() {
      return string(request.path).matches('^/databases/[^/]+/documents/artifacts/sambong-class-2026/public/data/approvedClassIds/[^/]+$');
    }

    // 실시간 알까기 하위 문서(live/state·live/black·live/white)와 그 아래 더 깊은 경로. 공개 와일드카드와 OR 되지 않게 빼 둡니다.
    function isAlkkagiLiveDoc() {
      return string(request.path).matches('^/databases/[^/]+/documents/artifacts/[^/]+/public/data/boardGameRooms/[^/]+/live/.+$');
    }

    // 보드게임 방(아래 전용 match만 쓰고, 공개 와일드카드에서는 뺍니다).
    function isBoardGameRoomDoc() {
      return string(request.path).matches('^/databases/[^/]+/documents/artifacts/[^/]+/public/data/boardGameRooms/.*');
    }

    // 예전 화면(v1.47)은 모르는 gameType을 오목으로 바꿔 덮어씁니다. 실시간 방은 종류를 바꾸지 못하고,
    // 다른 방이 실시간 방으로 바뀌지도 못합니다. 실시간 방 id는 alkl_ 로 시작합니다.
    function boardRoomLiveTypeKept() {
      return (resource.data.get('gameType', '') == 'alkkagiLive')
        == (request.resource.data.get('gameType', '') == 'alkkagiLive');
    }

    function boardRoomLiveIdOk(roomId) {
      return roomId.matches('^alkl_.*') == (request.resource.data.gameType == 'alkkagiLive');
    }

    // live 문서는 같은 학급(appId) 아래 실제로 있는 실시간 방이 두는 중(또는 막 끝난)일 때만 씁니다.
    function alkLiveRoom(appId, roomId) {
      return get(/databases/$(database)/documents/artifacts/$(appId)/public/data/boardGameRooms/$(roomId)).data;
    }

    function alkLiveRoomOpen(room) {
      return room.get('gameType', '') == 'alkkagiLive'
        && room.get('status', '') in ['playing', 'finished']
        && room.get('game', {}) is map
        && room.game.get('gid', null) is int;
    }

    // live 문서는 그 방의 방장(hostUid)이나 참가자(memberUids) 기기만 씁니다(#88 방 모양).
    // 남이 game.gid가 바뀐 틈에 새 판 자리(live/black·white)나 스냅샷을 먼저 차지하지 못해요.
    // hostUid·memberUids가 없는 방(옛 화면이 만든 방)은 live를 쓰지 못해요. 실시간 방은 #88 앱(v1.50)부터만 만들어요.
    function alkLiveParty(room) {
      let u = room.get('memberUids', []);
      return request.auth.uid == room.get('hostUid', '')
        || (u is list && request.auth.uid in u);
    }

    // 알 하나: id·색·좌표·속도·살아 있음 7칸만 받습니다. 칸 수가 7이고 7칸을 모두 읽으므로 다른 칸은 못 들어가요.
    // 규칙 식 1000개 한도 안에 넉넉히 들어가도록 묶어서 봅니다.
    // - id+색 글자는 'b1black'·'w5white' 같은 모양만(흑 알은 black, 백 알은 white, 긴 글자 불가)
    // - x·y·vx·vy는 숫자(더하기가 숫자여야 함), alive는 참거짓(조건식이 오류 없이 돌아야 함)
    // 숫자 범위는 앱(sanitizeLiveStones)이 맞추고, 규칙은 문서가 부풀 수 있는 형식(긴 글자·목록·묶음)을 막습니다.
    function alkLiveStoneOk(s) {
      return s.size() == 7
        && (s.id + s.color).matches('^(b[1-5]black|w[1-5]white)$')
        && (s.x + s.y + s.vx + s.vy + (s.alive ? 0 : 0)) is number;
    }

    function alkLiveStonesOk(a) {
      return a is list && a.size() == 10
        && alkLiveStoneOk(a[0]) && alkLiveStoneOk(a[1]) && alkLiveStoneOk(a[2]) && alkLiveStoneOk(a[3]) && alkLiveStoneOk(a[4])
        && alkLiveStoneOk(a[5]) && alkLiveStoneOk(a[6]) && alkLiveStoneOk(a[7]) && alkLiveStoneOk(a[8]) && alkLiveStoneOk(a[9]);
    }

    function alkLiveLastOk(v) {
      return v == null || (
        v.size() == 4
        && v.by in ['black', 'white']
        && v.id.matches('^[bw][1-5]$')
        && (v.n + v.step) is int
      );
    }

    function alkLiveOverOk(v) {
      return v == null || (
        v.size() == 2
        && v.endReason in ['out', 'forfeit', 'draw', 'disconnect']
        && v.winner in ['', 'black', 'white']
      );
    }

    // 샷 의도: {v:1, id:'b1'~'b5' 또는 'w1'~'w5'(내 자리 색), a: 각도 정수, p: 힘 정수}
    // #100: 앱이 실제로 낼 수 있는 값만 받아요(alkkagiPhysics·alkkagiLiveBoard 기준).
    // - 방향 a: 각도(라디안)×10000, (-π, π] → -31416 ~ 31416
    // - 힘 p: 당긴 정도(0.05~1)×10000 → 500 ~ 10000 (MIN_POWER 0.05 아래는 앱이 쏘지 않아요, 최대 힘 1)
    function alkLiveShotOk(seat, shot) {
      return shot is map
        && shot.keys().hasOnly(['v', 'id', 'a', 'p'])
        && shot.keys().hasAll(['v', 'id', 'a', 'p'])
        && shot.v == 1
        && shot.id is string
        && shot.id.matches(seat == 'black' ? '^b[1-5]$' : '^w[1-5]$')
        && shot.a is int && shot.a >= -31416 && shot.a <= 31416
        && shot.p is int && shot.p >= 500 && shot.p <= 10000;
    }

    function alkLiveSeatShapeOk(seat) {
      let d = request.resource.data;
      return d.keys().hasOnly(['seat', 'sid', 'gid', 'n', 'shot', 'shotAt', 'seenAt'])
        && d.keys().hasAll(['seat', 'sid', 'gid', 'n', 'shot', 'shotAt', 'seenAt'])
        && d.seat == seat
        && d.sid is string && d.sid.size() > 0 && d.sid.size() <= 20
        && d.gid is int && d.gid >= 0
        && d.n is int && d.n >= 0 && d.n <= 1000000
        && (d.shot == null || alkLiveShotOk(seat, d.shot))
        && d.shotAt is timestamp
        && d.seenAt == request.time;
    }

    // 새 판(gid가 커짐)이나 처음 만들 때: 번호 0, 샷 없음.
    function alkLiveSeatFresh() {
      let d = request.resource.data;
      return d.n == 0 && d.shot == null && d.shotAt == request.time;
    }

    // 같은 판: 접속 표시만(번호·샷 그대로) 또는 번호를 하나 올려 새 샷(서버 시각으로 4.5초 지나야 함).
    // 첫 샷(번호 0→1)은 자리를 만든 직후라도 바로 쏠 수 있어요. 그다음부터는 서버 시각 4.5초 간격.
    function alkLiveSeatNext() {
      let d = request.resource.data;
      let o = resource.data;
      return d.gid == o.gid && d.sid == o.sid && (
        (d.n == o.n && d.shot == o.shot && d.shotAt == o.shotAt)
        || (d.n == o.n + 1 && d.shot != null && d.shotAt == request.time
            && (o.n == 0 || request.time > o.shotAt + duration.value(4500, 'ms')))
      );
    }

    // 판 스냅샷: 14칸 모두의 형식을 봅니다(알은 꼭 10개). 그래서 문서가 크게 부풀지 못합니다(약 2KB 안).
    // 14칸이고 아래에서 14칸을 모두 읽으므로 다른 칸은 들어갈 수 없습니다.
    function alkLiveStateShapeOk() {
      let d = request.resource.data;
      return d.size() == 14
        && (d.gid + d.seq + d.epoch + d.step + d.shots) is int
        && d.seq >= 0 && d.epoch >= 0 && d.step >= 0 && d.shots >= 0
        && d.hostSeat in ['black', 'white']
        && d.moving is bool
        && alkLiveStonesOk(d.stones)
        && d.applied.size() == 2 && d.rejected.size() == 2 && d.lastShotAt.size() == 2
        && (d.applied.black + d.applied.white + d.rejected.black + d.rejected.white + d.lastShotAt.black + d.lastShotAt.white) is int
        && alkLiveLastOk(d.last)
        && alkLiveOverOk(d.over)
        && d.at == request.time;
    }

    // 새 판(방의 gid가 바뀜)이면 seq·epoch를 처음부터(seq 0~1, epoch 0~1) 시작합니다.
    function alkLiveStateFresh() {
      let d = request.resource.data;
      return d.seq <= 1 && d.epoch <= 1;
    }

    // 같은 판 스냅샷은 앞으로 한 칸씩만 갑니다. 같은 호스트는 seq+1만,
    // 호스트를 넘겨받을 때(승계)는 epoch+1이고 seq는 지금 값+1을 넘지 못합니다.
    // 그래서 큰 값을 한 번 써서 판을 잠글 수 없습니다.
    function alkLiveStateNext() {
      let d = request.resource.data;
      let o = resource.data;
      return d.gid == o.gid && (
        (d.epoch == o.epoch && d.seq == o.seq + 1 && d.hostSeat == o.hostSeat)
        || (d.epoch == o.epoch + 1 && d.seq <= o.seq + 1)
      );
    }

    function isEstateStateDoc() {
      return string(request.path).matches('^/databases/[^/]+/documents/artifacts/[^/]+/public/data/estate/state$');
    }

    // 자리 배열이 없거나 비어 있으면 기존 주인·임시 배치를 지우지 못합니다.
    function estateSeatsPresent() {
      return request.resource.data.seats is list
        && request.resource.data.seats.size() > 0
        && request.resource.data.seats.size() <= 144;
    }

    function isStudentDoc() {
      return string(request.path).matches('^/databases/[^/]+/documents/artifacts/[^/]+/public/data/students/[^/]+$');
    }

    function isMasterPinDoc(studentId) {
      return studentId == 'student_gm' || studentId == 'student_gm_a';
    }

    function masterPinShapeOk() {
      return request.resource.data.pin is string
        && request.resource.data.pin.matches('^[0-9]{4}$');
    }

    // 기기 바꿔도 같은 비밀번호를 쓰도록, 로그인한 사용자는 마스터 문서에 4자리 pin만 남깁니다.
    function masterPinOnlyWrite(studentId) {
      return signedIn()
        && isMasterPinDoc(studentId)
        && masterPinShapeOk()
        && (
          request.method == 'create'
            ? request.resource.data.keys().hasOnly(['pin'])
            : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pin'])
        );
    }

    function isOxQuizBankDoc() {
      return string(request.path).matches('^/databases/[^/]+/documents/artifacts/[^/]+/public/data/oxQuizBank($|/.*)');
    }

    // 학생 문서는 공개 와일드카드와 OR 됩니다. 슬롯 키 검사는 이쪽에도 있어야 우회되지 않습니다.
    function studentClassXpSlotAllowed() {
      return !isStudentDoc()
        || request.method == 'delete'
        || (request.method == 'create' && !('lastClassXpSlot' in request.resource.data))
        || (request.method == 'update' && classXpSlotWriteOk());
    }

    // 학생 화면이 쓰지 않는 것이 확인된 키만 둡니다. 애매한 키는 넣지 않습니다.
    function gmOnlyKeys() {
      return [
        'shopPrices',
        'customShopItems',
        'convenienceItems',
        'customQuests',
        'deletedQuestIds',
        'customJobs',
        'jobOverrides',
        'deletedJobIds',
        'worldSettings',
        'raidPassword',
        'weekendRaidRewardXp',
        'weekendRaidRewardBong',
        'constitutionItems',
        'bankInterestPercent',
        'bankLoanLimitPerStudent',
        'bankTransferFeeBong',
        'dragonBallFindXp',
        'dragonBallFindBong',
        'dragonBallCompleteXp',
        'dragonBallCompleteBong',
        'convenienceDeliveryFee',
        'announcement',
        'morningActivityNotice',
        'screenNotice',
        'classTimetable',
        'birthdayCelebrations',
        'classModules',
        'externalPortals',
        'weatherRegion',
        'classToolShare',
        'researchJournal',
        'researchSurveyUrl',
        'researchSurveyNote',
        'classWatchOn',
        'curriculumTags',
        'curriculumMapping',
        'applyDefaultTemplatePending',
        'season2StartedAt',
        'season2StartedBy',
        'season2WeaponsClearedAt',
        'season2DragonBallsClearedAt',
        'shieldStockFixedTo5At',
        'season1ItemsRefundedAt',
        'raidPasswordNeedsSetup',
        'learningThermometer'
      ];
    }

    function twoDigits(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    // slotMs를 UTC epoch로 읽은 뒤 9시간을 더하면, hours()/minutes()가 한국 표준시 벽시계가 됩니다.
    function autoXpKst(slotMs) {
      return timestamp.value(slotMs) + duration.value(9, 'h');
    }

    function autoXpIsClassEnd(slotMs) {
      let kst = autoXpKst(slotMs);
      return kst.seconds() == 0
        && kst.nanos() == 0
        && (
          (kst.hours() == 9 && kst.minutes() == 40)
          || (kst.hours() == 10 && kst.minutes() == 30)
          || (kst.hours() == 11 && kst.minutes() == 20)
          || (kst.hours() == 12 && kst.minutes() == 10)
          || (kst.hours() == 13 && kst.minutes() == 50)
          || (kst.hours() == 14 && kst.minutes() == 40)
        );
    }

    function autoXpKey(slotMs) {
      let kst = autoXpKst(slotMs);
      return string(kst.year()) + '_' + twoDigits(kst.month()) + '_' + twoDigits(kst.day())
        + '_' + twoDigits(kst.hours()) + ':' + twoDigits(kst.minutes());
    }

    function kstNow() {
      return request.time + duration.value(9, 'h');
    }

    // 1970-01-01은 목요일. date()는 9시간을 더한 시각의 달력 날짜(한국 표준시)입니다.
    // 0=일요일 … 6=토요일. rules에 weekday()가 없어 epoch 일로 계산합니다.
    function kstWeekdaySunday0() {
      return (math.floor(kstNow().date().toMillis() / 86400000) + 4) % 7;
    }

    // 오늘 이미 지난 종 가운데 가장 최근 시각. 09:40 이전이면 빈 문자열입니다.
    function classXpCatchupClock() {
      let mins = kstNow().hours() * 60 + kstNow().minutes();
      return mins >= 880 ? '14:40'
        : mins >= 830 ? '13:50'
        : mins >= 730 ? '12:10'
        : mins >= 680 ? '11:20'
        : mins >= 630 ? '10:30'
        : mins >= 580 ? '09:40'
        : '';
    }

    // 평일에만, 오늘 가장 최근 종 키. 주말·첫 종 이전은 빈 문자열이라 지급이 거부됩니다.
    // 다음 종 전까지 그 키만 허용하므로, 놓친 이전 종을 한꺼번에 받지 못합니다.
    function classXpCatchupKeyNow() {
      let clock = classXpCatchupClock();
      let kst = kstNow();
      let weekday = kstWeekdaySunday0();
      return clock != '' && weekday >= 1 && weekday <= 5
        ? string(kst.year()) + '_' + twoDigits(kst.month()) + '_' + twoDigits(kst.day()) + '_' + clock
        : '';
    }

    // 공지 문장은 저장하지 않습니다. 앱이 slotMs로 만듭니다.
    // autoXp는 공지용입니다. 지급 여부는 학생 문서 lastClassXpSlot이 정합니다.
    // 키는 오늘 가장 최근 종(이미 지난 것, 그 1분이 지난 뒤 포함)과 같아야 합니다.
    function autoXpShapeOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(['lastAutoXpTime', 'slotMs'])
        && d.lastAutoXpTime is string
        && d.slotMs is int
        && d.slotMs > 1577836800000
        && d.slotMs < 4102444800000
        && d.slotMs % 60000 == 0
        && d.slotMs <= request.time.toMillis() + 15000
        && autoXpIsClassEnd(d.slotMs)
        && d.lastAutoXpTime == autoXpKey(d.slotMs)
        && d.lastAutoXpTime == classXpCatchupKeyNow();
    }

    // 슬롯 키는 오늘 가장 최근 종에 경험치가 정확히 +5일 때만 바꿉니다.
    // xp가 숫자가 아니면 이 분기는 거부됩니다. 지우기는 경험치를 0으로 되돌리는 초기화에서만 됩니다.
    function classXpSlotWriteOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['lastClassXpSlot'])
        || (
          classXpCatchupKeyNow() != ''
          && request.resource.data.lastClassXpSlot is string
          && request.resource.data.lastClassXpSlot == classXpCatchupKeyNow()
          && request.resource.data.xp is number
          && resource.data.xp is number
          && request.resource.data.xp == resource.data.xp + 5
        )
        || (
          request.resource.data.xp is number
          && request.resource.data.xp == 0
          && (
            !('lastClassXpSlot' in request.resource.data)
            || request.resource.data.lastClassXpSlot == ''
          )
        );
    }

    // 잠금 소유자·시도 번호·예전 값 표식은 새 클라이언트만 씁니다.
    // 규칙을 먼저 배포해도, 새로고침 전 화면의 저장은 이 필드 없이 통과합니다.
    // 필드가 있을 때만 형식을 검사합니다.
    function thermometerOptionalFieldsOk(d) {
      return (!('settlementLockOwner' in d) || (
          d.settlementLockOwner is string
          && d.settlementLockOwner.size() <= 80
        ))
        && (!('settlementAttempt' in d) || (
          d.settlementAttempt is int
          && d.settlementAttempt >= 0
          && d.settlementAttempt <= 1000000
        ))
        && (!('usedStaleValues' in d) || d.usedStaleValues is bool);
    }

    function thermometerShapeOk() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'date', 'min', 'max', 'settledDate', 'lastSettlementAt',
          'settlementKey', 'settlementStatus', 'settlementStartedAt',
          'settlementLockOwner', 'settlementAttempt', 'usedStaleValues',
          'settlementAppliedCount', 'settlementTotalDelta'
        ])
        && d.date is string
        && d.date.size() >= 8
        && d.date.size() <= 10
        && d.min is int
        && d.min >= -500
        && d.min < 0
        && d.max is int
        && d.max > 0
        && d.max <= 500
        && d.min < d.max
        && d.settledDate is string
        && d.settledDate.size() <= 10
        && d.lastSettlementAt is number
        && d.settlementKey is string
        && d.settlementKey.size() <= 12
        && d.settlementStatus is string
        && d.settlementStatus.size() <= 20
        && d.settlementStartedAt is number
        && thermometerOptionalFieldsOk(d)
        && d.settlementAppliedCount is int
        && d.settlementAppliedCount >= 0
        && d.settlementAppliedCount <= 40
        && d.settlementTotalDelta is int
        && d.settlementTotalDelta >= -20000
        && d.settlementTotalDelta <= 20000;
    }

    function thermometerVoteInRange(appId, value) {
      let parent = get(/databases/$(database)/documents/artifacts/$(appId)/public/data/settings/learningThermometer).data;
      return parent.min is int
        && parent.max is int
        && value >= parent.min
        && value <= parent.max;
    }

    function thermometerVoteOk(appId, studentId) {
      let d = request.resource.data;
      return studentId.matches('^[A-Za-z0-9_-]{1,24}$')
        && d.keys().hasOnly(['value'])
        && d.value is int
        && exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/settings/learningThermometer)
        && thermometerVoteInRange(appId, d.value)
        && (isAdminForApp(appId) || studentId == request.auth.uid);
    }

    function shopDiscountUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['shopDiscount']);
    }

    function gmOnlyUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(gmOnlyKeys());
    }

    function createHasShopDiscount() {
      return 'shopDiscount' in request.resource.data;
    }

    function createTouchesGmOnly() {
      return request.resource.data.keys().hasAny(gmOnlyKeys());
    }

    function shopDiscountChangeIsValid() {
      let d = request.resource.data.shopDiscount;
      return d is map
        && d.keys().hasAll(['enabled', 'percent'])
        && d.enabled is bool
        && d.percent is int
        && d.percent >= 0
        && d.percent <= 100
        && (
          d.enabled == false
          || (
            d.keys().hasAll(['startAt', 'endAt'])
            && d.startAt is number
            && d.endAt is number
            && d.startAt < d.endAt
          )
        );
    }

    function studentCreateIsSafe() {
      return signedIn()
        && request.resource.data.xp is number
        && request.resource.data.bong is number
        && request.resource.data.xp >= 0
        && request.resource.data.bong >= -2000
        && !('lastClassXpSlot' in request.resource.data);
    }

    function studentUpdateIsSafe() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return signedIn()
        // XP: 하락(마스터 수정·차감) 허용, 1회 저장 상승은 650 이하(비정상 급등 방지)
        && (!changed.hasAny(['xp']) || (
          request.resource.data.xp is number
          && request.resource.data.xp >= 0
          && (
            request.resource.data.xp <= resource.data.xp
            || request.resource.data.xp <= resource.data.xp + 650
          )
        ))
          // 봉은 정상 구매/점심 차감·계좌이체(최대 5000+수수료)·대출 자동이체를 허용하고, 오래 열린 창의 큰 마이너스 덮어쓰기는 차단합니다.
          && (!changed.hasAny(['bong'])
            || request.resource.data.bong >= resource.data.bong
            || (
              request.resource.data.bong >= -2000
              && request.resource.data.bong >= resource.data.bong - 5050
            ))
          && classXpSlotWriteOk();
    }

    match /artifacts/{appId}/public/data/students/{studentId} {
      allow read: if true;
      allow create: if studentCreateIsSafe() || masterPinOnlyWrite(studentId);
      allow update: if studentUpdateIsSafe() || masterPinOnlyWrite(studentId);
      allow delete: if false;
    }

    // 보드게임 방: 로그인(익명 인증)한 학급 화면에서만 만들고 고칩니다.
    // 학번·참가 순서·수 두기 내용은 클라이언트 상태 머신(boardGameRooms.js)이 검사합니다.
    // 방장은 hostUid(만든 기기의 로그인 uid), 참가자는 memberUids(참가자 uid 목록)로 알아봅니다.
    // hostUid가 없는 옛 방은 예전처럼 로그인한 누구나 고치고 지울 수 있습니다.
    // 만든 지(createdAt) 30분이 지난 방은 로그인한 누구나 지울 수 있습니다.
    // 단, 두는 중(playing)인 판은 마지막 활동(lastActivityAt)이 숫자이고 10분 넘게 지났을 때만 지웁니다.
    // 옛 화면(hostUid를 모르는 앱)은 문서 전체를 hostUid 없이 덮어써서 이 규칙에서 참가·만들기·두기가 막힙니다.
    // 그래서 이 규칙은 앱을 먼저 배포하고, 방과 후 모든 탭이 새로고침된 뒤에 게시합니다.
    match /artifacts/{appId}/public/data/boardGameRooms/{roomId} {
      function roomHostUid(d) {
        return d.get('hostUid', '');
      }
      function roomIsLegacy(d) {
        return !(roomHostUid(d) is string) || roomHostUid(d) == '';
      }
      function roomIsMine(d) {
        return roomHostUid(d) == request.auth.uid;
      }
      function roomMemberUids(d) {
        let u = d.get('memberUids', []);
        return u is list ? u : [];
      }
      function roomMembers(d) {
        let m = d.get('members', []);
        return m is list ? m : [];
      }
      // 방장이거나 지금 참가자(memberUids)인 기기
      function roomIsParty(d) {
        return roomIsMine(d) || request.auth.uid in roomMemberUids(d);
      }
      function roomCleanupAgeDue(d) {
        let created = d.get('createdAt', 0);
        let last = d.get('lastActivityAt', 0);
        return created is number && created > 0
          && request.time.toMillis() - created >= 1800000
          && (d.get('status', '') != 'playing'
            || (last is number && request.time.toMillis() - last >= 600000));
      }
      function roomIdle(d) {
        let last = d.get('lastActivityAt', 0);
        return last is number && request.time.toMillis() - last >= 600000;
      }
      function roomTimesOk(n) {
        return n.get('createdAt', null) is number && n.get('lastActivityAt', null) is number;
      }
      // 서버 시각 앞뒤 10분 안의 숫자
      function roomTimeNear(v) {
        return v is number
          && v <= request.time.toMillis() + 600000
          && v >= request.time.toMillis() - 600000;
      }
      // 새로 만드는 방 모양(R2-1): 대기 상태, 방장 한 명(내 uid), 신청 없음, 만든 시각·마지막 활동이 서버 시각 앞뒤 10분 안.
      // 미래 시각으로 만들어 정리를 피하거나 로비 맨 위를 차지하는 방을 막아요.
      function roomFreshShape(n) {
        let m = roomMembers(n);
        return n.get('status', '') == 'waiting'
          && roomTimeNear(n.get('createdAt', null))
          && roomTimeNear(n.get('lastActivityAt', null))
          && n.get('hostId', '') is string && n.get('hostId', '') != ''
          && m.size() == 1
          && m[0].get('id', '') == n.get('hostId', '')
          && m[0].get('uid', '') == request.auth.uid
          && roomMemberUids(n) == [request.auth.uid]
          && n.get('joinRequests', []) == []
          && n.get('participantIds', [n.get('hostId', '')]) == [n.get('hostId', '')];
      }
      // lastActivityAt: 그대로이거나, 줄지 않고 서버 시각 앞뒤 10분 안의 숫자
      function roomActivityOk(d, n) {
        let before = d.get('lastActivityAt', 0);
        let after = n.get('lastActivityAt', 0);
        return after == before
          || (after is number
            && (!(before is number) || after >= before)
            && after <= request.time.toMillis() + 600000
            && after >= request.time.toMillis() - 600000);
      }
      // createdAt: 그대로. 없던 방에는 방장만 숫자로 넣을 수 있습니다.
      function roomCreatedOk(d, n) {
        return ('createdAt' in d && n.get('createdAt', null) == d.createdAt)
          || (!('createdAt' in d) && (!('createdAt' in n) || (roomIsMine(d) && n.createdAt is number)));
      }
      // 참가자가 자기 자리 하나만 빼기. 승인 없이 자리 넣기는 막아요(R2-3, 자리는 방장 승인으로만 생겨요).
      function roomSelfSeatOnly(d, n) {
        let dm = roomMembers(d);
        let nm = roomMembers(n);
        let du = roomMemberUids(d);
        let nu = roomMemberUids(n);
        let me = request.auth.uid;
        return nm.size() + 1 == dm.size() && dm.hasAll(nm)
          && dm.removeAll(nm).size() == 1 && dm.removeAll(nm)[0].get('uid', '') == me
          && (me in du) && nu.size() + 1 == du.size() && du.hasAll(nu) && !(me in nu);
      }
      function roomMembersOk(d, n) {
        return (n.get('members', null) == d.get('members', null)
            && n.get('memberUids', null) == d.get('memberUids', null))
          || roomIsMine(d)
          || roomSelfSeatOnly(d, n);
      }
      // R2-4·r4 ④: uid 없이 승인된 자리(옛 화면이 섞였을 때 생겨요) 하나에 내 uid를 채우는 쓰기.
      // 자리 칸은 그 자리 uid만 바뀌어야 해요. 대기·두는 중인 방에서만 돼요.
      // 채우는 쓰기에 두기(판·차례·결과)를 함께 실어도 돼요(규칙이 바뀐 뒤에도 두던 판을 끝까지 둘 수 있게).
      // 이 쓰기를 한 기기는 그 순간부터 참가자로 봐요(상태 바꾸기 기준).
      function roomClaimSeat(d, n) {
        let dm = roomMembers(d);
        let nm = roomMembers(n);
        let me = request.auth.uid;
        let gone = dm.removeAll(nm);
        let added = nm.removeAll(dm);
        return d.get('status', '') in ['waiting', 'playing']
          && !(me in roomMemberUids(d))
          && !roomIsMine(d)
          && nm.size() == dm.size()
          && gone.size() == 1 && added.size() == 1
          && gone[0].get('uid', '') == ''
          && added[0].get('uid', '') == me
          && added[0].diff(gone[0]).affectedKeys().hasOnly(['uid'])
          && roomMemberUids(n).size() == roomMemberUids(d).size() + 1
          && roomMemberUids(n).hasAll(roomMemberUids(d))
          && (me in roomMemberUids(n));
      }
      // R2-3: 방장·참가자가 아닌 기기가 할 수 있는 일만.
      // - 대기 방에 내 신청(내 uid, pending) 하나 넣기·바꾸기, 또는 내 신청 빼기
      // - 10분 넘게 멈춘 방 닫기
      // 판(game)·자리·상태·방 설정은 못 바꾸고, 두는 중인 판의 마지막 활동도 못 밀어요.
      function roomOutsiderJoinOk(d, n) {
        let dj = d.get('joinRequests', []);
        let nj = n.get('joinRequests', []);
        let me = request.auth.uid;
        let addedJ = nj.removeAll(dj);
        let goneJ = dj.removeAll(nj);
        let dp = d.get('participantIds', []);
        let np = n.get('participantIds', []);
        return d.get('status', '') == 'waiting'
          && dj is list && nj is list && dp is list && np is list
          // r4 ③(c2b): 이미 방에 있는 학번(방장·자리·남의 신청)으로는 새 신청을 못 넣어요. 내 신청을 같은 학번으로 바꾸는 것만 돼요.
          && (addedJ.size() == 0 || !(addedJ[0].get('id', '') in dp)
            || (goneJ.size() == 1 && goneJ[0].get('id', '') == addedJ[0].get('id', '')))
          && n.diff(d).affectedKeys().hasOnly(['joinRequests', 'participantIds', 'lastActivityAt', 'updatedAt', 'round'])
          && n.get('round', 0) == d.get('round', 0)
          && addedJ.size() <= 1 && goneJ.size() <= 1 && addedJ.size() + goneJ.size() >= 1
          && (addedJ.size() == 0
            || (addedJ[0].get('uid', '') == me && addedJ[0].get('status', '') == 'pending'))
          && (goneJ.size() == 0 || goneJ[0].get('uid', '') == me)
          && np.removeAll(dp).hasOnly(addedJ.size() == 1 ? [addedJ[0].get('id', '')] : [])
          && dp.removeAll(np).hasOnly(goneJ.size() == 1 ? [goneJ[0].get('id', '')] : []);
      }
      function roomOutsiderCloseOk(d, n) {
        return n.get('status', '') == 'closed'
          && roomIdle(d)
          && n.diff(d).affectedKeys().hasOnly(['status', 'lastActivityAt', 'updatedAt', 'round'])
          && n.get('round', 0) == d.get('round', 0);
      }
      function roomOutsiderOk(d, n) {
        return roomIsParty(d)
          || roomOutsiderJoinOk(d, n)
          || roomOutsiderCloseOk(d, n);
      }
      // 상태: playing·finished → waiting 금지, closed는 되돌리지 않음.
      // finished·closed로 바꾸기와 끝난 판 다시 두기는 방장·참가자만(10분 넘게 멈춘 방 닫기는 누구나).
      function roomStatusOk(d, n, party) {
        let a = d.get('status', '');
        let b = n.get('status', '');
        return a == b
          || (a == 'waiting' && b == 'playing')
          || (a in ['waiting', 'playing'] && b == 'finished' && party)
          || (a == 'finished' && b == 'playing' && party)
          || (a in ['waiting', 'playing', 'finished'] && b == 'closed' && (party || roomIdle(d)));
      }
      // 보통 쓰기(참가 신청·승인·두기·나가기): 방장·학번·만든 시각은 그대로
      function roomUpdateKeepsRoom(d, n) {
        let claim = roomClaimSeat(d, n);
        return roomHostUid(n) == roomHostUid(d)
          && (roomIsLegacy(d)
            || (n.get('hostId', '') == d.get('hostId', '')
              && roomCreatedOk(d, n)
              && roomActivityOk(d, n)
              && (claim || roomMembersOk(d, n))
              && roomStatusOk(d, n, claim || roomIsParty(d))
              && (claim || roomOutsiderOk(d, n))));
      }
      // 같은 문서에 새로 만든 방: 새 방 모양(roomFreshShape)이고, 만든 시각은 예전 방보다 앞서지 않음
      function roomFreshOver(d, n) {
        let before = d.get('createdAt', 0);
        return roomFreshShape(n)
          && (!(before is number) || n.createdAt >= before);
      }
      // hostUid가 없는 옛 방에 방장이 내 uid를 적기(만든 시각 그대로, 마지막 활동은 서버 시각 근처)
      function roomLegacyClaimOk(d, n) {
        return (('createdAt' in d) ? n.get('createdAt', null) == d.createdAt : roomTimeNear(n.get('createdAt', null)))
          && roomActivityOk(d, n);
      }
      // 같은 문서에 새 방 덮어쓰기(hostUid를 내 것으로):
      // - 옛 방(hostUid 없음): 내 uid를 적는 쓰기이거나 새 방 모양
      // - 새 방 모양으로, 30분 정리 대상 위에, 또는 내 방(hostUid가 내 uid)이 끝났거나(finished·closed) 10분 넘게 비었을 때만.
      //   R2-2: hostUid가 있는 방은 같은 학번(hostId)만으로는 덮어쓰지 못해요(남의 학번으로 방을 막는 걸 막아요).
      // (두는 중인 판·끝난 판을 대기로 되돌리는 쪼개 쓰기는 여기서도 막혀요.)
      function roomOverwriteOk(d, n) {
        return roomIsMine(n) && roomTimesOk(n) && (
          (roomIsLegacy(d) && (roomLegacyClaimOk(d, n) || roomFreshOver(d, n)))
          || (roomFreshOver(d, n) && (
            roomCleanupAgeDue(d)
            || (roomIsMine(d) && (
              d.get('status', '') in ['finished', 'closed']
              || roomIdle(d)))
          ))
        );
      }

      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.gameType is string
        && request.resource.data.hostId is string
        && request.resource.data.status is string
        && roomTimesOk(request.resource.data)
        && roomIsMine(request.resource.data)
        && roomFreshShape(request.resource.data)
        && boardRoomLiveIdOk(roomId);
      allow update: if signedIn() && boardRoomLiveTypeKept() && (
        roomUpdateKeepsRoom(resource.data, request.resource.data)
        || roomOverwriteOk(resource.data, request.resource.data)
      );
      // 지우기: 내 방, 옛 방, 30분 정리 대상, 참가자가 닫은(closed) 방,
      // 또는 r4 ②: 참가자가 10분 넘게 둔 끝난(finished) 방
      allow delete: if signedIn() && (
        roomIsMine(resource.data)
        || roomIsLegacy(resource.data)
        || roomCleanupAgeDue(resource.data)
        || (resource.data.get('status', '') == 'closed' && roomIsParty(resource.data))
        || (resource.data.get('status', '') == 'finished' && roomIsParty(resource.data) && roomIdle(resource.data))
      );
    }

    // 실시간 알까기. 판 계산은 방장(호스트) 기기가 하고 live/state 에 스냅샷을 씁니다.
    // 각자 live/{자리} 에 샷 의도와 접속 표시를 씁니다. 같은 자리 샷은 서버 시각으로 4.5초 간격이 있어야 합니다.
    // 쓰기는 같은 학급 아래 실제로 있는 실시간 방이 두는 중일 때만, gid는 그 방의 지금 판(game.gid)과 같아야 합니다.
    // 지우기는 방 문서가 없을 때(방을 지운 뒤나 같은 묶음에서 함께)와 선생님만 됩니다. 그래서 지웠다 다시 만드는 되감기가 막힙니다.
    // 쓰는 기기는 그 방의 방장·참가자 uid여야 합니다(alkLiveParty).
    // #100: 자리(흑·백)를 uid에 묶지는 않아요. 선생님 결정으로 '같이 하기'(한 기기·한 계정이 두 자리)를 막지 않기 위해서예요.
    //   대신 샷 번호 n은 한 칸씩(+1)만, 힘·방향은 앱이 낼 수 있는 범위만, 같은 자리 샷은 서버 시각 4.5초 간격이라 상대 자리에 써도 크게 망가뜨리지 못해요.
    match /artifacts/{appId}/public/data/boardGameRooms/{roomId}/live/{docId} {
      allow read: if true;
      allow create: if signedIn()
        && alkLiveRoomOpen(alkLiveRoom(appId, roomId))
        && alkLiveParty(alkLiveRoom(appId, roomId))
        && request.resource.data.gid == alkLiveRoom(appId, roomId).game.gid
        && (
          (docId == 'state' && alkLiveStateShapeOk() && alkLiveStateFresh())
          || (docId in ['black', 'white'] && alkLiveSeatShapeOk(docId) && alkLiveSeatFresh())
        );
      allow update: if signedIn()
        && alkLiveRoomOpen(alkLiveRoom(appId, roomId))
        && alkLiveParty(alkLiveRoom(appId, roomId))
        && request.resource.data.gid == alkLiveRoom(appId, roomId).game.gid
        && (
          (docId == 'state' && alkLiveStateShapeOk() && (
            (request.resource.data.gid != resource.data.gid && alkLiveStateFresh())
            || alkLiveStateNext()
          ))
          || (docId in ['black', 'white'] && alkLiveSeatShapeOk(docId) && (
            (request.resource.data.gid != resource.data.gid && alkLiveSeatFresh())
            || alkLiveSeatNext()
          ))
        );
      allow delete: if signedIn() && (
        !existsAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/boardGameRooms/$(roomId))
        || isAdmin()
      );
    }

    // 부동산 자리표. 공개 와일드카드와 OR 되지 않게 빼 둡니다.
    // 로그인한 학생의 자리 구매는 좌석 배열이 있을 때만 허용하고, 빈 배열·삭제로 자리를 지우지는 못합니다.
    // 상점 가격 등 GM 전용 키는 아래 settings/global 의 #68 조건을 유지합니다. 학생 화면에는 열지 않습니다.
    match /artifacts/{appId}/public/data/estate/state {
      allow read: if true;
      allow create: if signedIn() && estateSeatsPresent();
      allow update: if signedIn() && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['seats'])
        || estateSeatsPresent()
      );
      allow delete: if false;
    }

    // 공개 와일드카드와 OR 되므로, 이 문서의 쓰기는 여기서만 허용합니다.
    // #68: 로그인한 사용자(익명 포함)가 GM 전용 키와 shopDiscount를 만들고 고칩니다.
    // 익명 인증에는 학번이 없어 규칙만으로 학생과 마스터를 나누지 않습니다.
    // 상점 가격 수정은 화면에서 마스터 PIN(isGM)일 때만 호출하고, 학생 계정에는 열지 않습니다.
    // 삭제는 금지입니다.
    match /artifacts/{appId}/public/data/settings/global {
      allow read: if true;
      allow create: if canCreateClassSettings(appId)
        && (!createHasShopDiscount() || shopDiscountChangeIsValid());
      allow update: if signedIn() && (
        (shopDiscountUntouched() && gmOnlyUntouched())
        || (
          isAdminForApp(appId)
          && (shopDiscountUntouched() || shopDiscountChangeIsValid())
        )
      );
      allow delete: if false;
    }

    // 수업 종료 자동 XP 공지. 지급 중복 방지는 학생 문서 lastClassXpSlot입니다.
    match /artifacts/{appId}/public/data/settings/autoXp {
      allow read: if true;
      allow create: if signedIn() && autoXpShapeOk();
      allow update: if signedIn()
        && autoXpShapeOk()
        && resource.data.slotMs is int
        && request.resource.data.slotMs >= resource.data.slotMs + 2400000;
      allow delete: if false;
    }

    // 학습 온도계 부모. 형식에 맞으면 로그인한 사용자(익명 포함)가 만들고 고칩니다.
    match /artifacts/{appId}/public/data/settings/learningThermometer {
      allow read: if true;
      allow create: if isAdminForApp(appId) && thermometerShapeOk();
      allow update: if isAdminForApp(appId) && thermometerShapeOk();
      allow delete: if false;
    }

    // 학생 본인 문서는 Firebase uid와 문서 ID가 같을 때만, 선생님은 학번 문서를 씁니다.
    // 익명 로그인 uid는 학번이 아니므로 학생은 다른 학생 값을 쓰지 못합니다.
    match /artifacts/{appId}/public/data/settings/learningThermometer/votes/{studentId} {
      allow read: if true;
      allow create, update: if signedIn() && thermometerVoteOk(appId, studentId);
      allow delete: if false;
    }

    // 학급 개설 표식. 로그인한 사용자가 자기 uid를 createdBy에 남길 때만 만듭니다.
    match /artifacts/sambong-class-2026/public/data/approvedClassIds/{classId} {
      allow read: if signedIn();
      allow create: if isAdminForApp('sambong-class-2026')
        && request.resource.data.keys().hasOnly(['classId', 'status', 'createdBy'])
        && request.resource.data.classId == classId
        && request.resource.data.status == 'approved'
        && request.resource.data.createdBy is string
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    // OX 퀴즈 문제 은행. artifacts/{학급}/public/data/oxQuizBank/{문서}
    // 함께 풀기 판(live, live/answers)과 무제한 도전(challengeBoard, challengeBoard/entries)은 아래 전용 match만 써요.
    match /artifacts/{appId}/public/data/oxQuizBank/{document=**} {
      allow read: if true;
      allow write: if signedIn() && !isOxGuardedDoc();
    }

    function isOxGuardedDoc() {
      return string(request.path).matches('^/databases/[^/]+/documents/artifacts/[^/]+/public/data/oxQuizBank/(live|challengeBoard)(/.*)?$');
    }

    // 함께 풀기 판 문서. 마스터도 익명 로그인이라 '선생님만'은 규칙으로 가르지 못해요.
    // 대신 모양·크기를 묶고, 진행 중인 판은 문제 목록을 바꾸지 못하며 문제 번호는 한 칸씩만 나가요.
    // 새 판(roundId가 바뀜)은 앞 판이 끝났거나(done·off) 30분 넘게 멈췄을 때만 열려요. 닫기(off)는 언제든 돼요.
    function oxLiveShapeOk(d) {
      return d.keys().hasOnly(['roundId', 'status', 'index', 'items', 'total', 'subjects', 'timeSec', 'lives', 'order', 'advance',
          'qStartAt', 'revealAt', 'tally', 'results', 'openedAt', 'updatedAt', 'revealed', 'finishedAt', 'frozen'])
        && d.roundId is string && d.roundId.size() >= 1 && d.roundId.size() <= 40
        && d.status in ['lobby', 'question', 'reveal', 'done', 'off']
        && d.items is list && d.items.size() >= 1 && d.items.size() <= 20
        && d.index is int && d.index >= 0 && d.index < d.items.size()
        && d.get('timeSec', 15) in [10, 15, 20, 30]
        && d.get('lives', 0) in [0, 1, 2, 3]
        && d.get('updatedAt', 0) is number
        && d.get('subjects', []) is list && d.get('subjects', []).size() <= 20
        && (d.get('results', null) == null || (d.results is list && d.results.size() <= 60))
        && (d.get('frozen', null) == null || (d.frozen is map && d.frozen.size() <= 20))
        && (d.get('tally', null) == null || (d.tally is map && d.tally.keys().hasOnly(['O', 'X', 'none'])));
    }

    // 고정 답(frozen)은 같은 판에서 '지금 문제' 칸 하나를 문제 → 정답 공개로 바뀔 때만 더할 수 있어요.
    // 이미 고정된 지난 칸은 바꾸거나 지우지 못해요. 새 판은 빈 frozen으로만 열어요.
    function oxLiveFrozenOk(d) {
      let nf = d.get('frozen', {});
      let of = resource.data.get('frozen', {});
      let k = string(resource.data.index);
      let fd = nf.diff(of);
      return fd.removedKeys().size() == 0
        && fd.changedKeys().size() == 0
        && fd.addedKeys().hasOnly([k])
        && (fd.addedKeys().size() == 0
          || (resource.data.status == 'question' && d.status == 'reveal' && d.index == resource.data.index
            && nf[k] is map && nf[k].size() <= 60));
    }

    function oxLiveWriteOk() {
      let d = request.resource.data;
      return oxLiveShapeOk(d) && (
        ((resource == null
          || (d.roundId != resource.data.roundId
            && (resource.data.get('status', 'off') in ['done', 'off']
              || request.time.toMillis() > resource.data.get('updatedAt', 0) + 1800000)))
          && d.get('frozen', {}).size() == 0)
        || (resource != null
          && d.roundId == resource.data.roundId
          && d.items == resource.data.items
          && (d.status == 'off' || (d.index >= resource.data.index && d.index <= resource.data.index + 1))
          && oxLiveFrozenOk(d))
      );
    }

    function oxLive(appId) {
      return get(/databases/$(database)/documents/artifacts/$(appId)/public/data/oxQuizBank/live).data;
    }

    // 학생 답 문서 live/answers/{학번}. 처음 쓴 기기(uid)에 묶여요.
    // 들어올 때는 빈 답으로만, 그 뒤에는 '지금 문제' 칸 하나만 더할 수 있어요(정답 공개 뒤·이미 고른 칸은 못 써요).
    function oxAnswerJoinOk(d, L) {
      return d.picks.size() == 0
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 24
        && d.joinIndex is int && d.joinIndex >= 0
        && d.joinIndex <= (L.status == 'reveal' ? L.index + 1 : (L.status == 'question' ? L.index : 0));
    }

    function oxAnswerPickOk(d, L) {
      let k = string(L.index);
      let pd = d.picks.diff(resource.data.picks);
      return resource.data.get('uid', '') == request.auth.uid
        && d.diff(resource.data).affectedKeys().hasOnly(['picks', 'updatedAt'])
        && L.status == 'question'
        && pd.addedKeys() == [k].toSet()
        && pd.changedKeys().size() == 0
        && pd.removedKeys().size() == 0
        && d.picks[k].keys().hasOnly(['p', 'ms'])
        && d.picks[k].p in ['O', 'X']
        && d.picks[k].ms is int && d.picks[k].ms >= 0 && d.picks[k].ms <= 600000;
    }

    function oxAnswerWriteOk(appId, sid) {
      let d = request.resource.data;
      let L = oxLive(appId);
      let joining = resource == null || resource.data.get('roundId', '') != L.roundId;
      return sid.matches('^[A-Za-z0-9_-]{1,24}$')
        && L.status in ['lobby', 'question', 'reveal']
        && d.keys().hasOnly(['roundId', 'name', 'joinIndex', 'picks', 'joinedAt', 'updatedAt', 'uid'])
        && d.roundId == L.roundId
        && d.uid == request.auth.uid
        && d.picks is map
        && (joining ? oxAnswerJoinOk(d, L) : oxAnswerPickOk(d, L));
    }

    // 무제한 도전 학생별 문서 challengeBoard/entries/{학번}. 반 전체가 동시에 써도 서로 부딪히지 않아요.
    // - 최고 기록은 올라가기만 해요(같은 개수면 더 빠른 기록으로만). 판 수는 한 번에 1씩만 늘어요.
    // - 오늘 봉 받은 판(dayDate·dayRunId·dayCorrect·dayBong)은 서버 기준 오늘(KST) 날짜로 하루 한 번만 적고, 그날은 바꾸지 못해요.
    // - 봉은 맞힌 수 ÷ 10 이하, 하루 20봉 이하이고, 맞힌 수는 최고 기록보다 클 수 없어요.
    // 익명 로그인에는 학번이 없어 '정말 그 학생인지'는 규칙으로 가르지 못해요(PR 본문 '남은 한계').
    function oxEntryDayOk(n, o) {
      return (n.get('dayDate', '') == o.get('dayDate', '')
          && n.get('dayRunId', '') == o.get('dayRunId', '')
          && n.get('dayCorrect', 0) == o.get('dayCorrect', 0)
          && n.get('dayBong', 0) == o.get('dayBong', 0)
          && n.get('dayPaidAt', 0) == o.get('dayPaidAt', 0))
        || (n.get('dayDate', '') != o.get('dayDate', '')
          && n.dayDate is string
          && n.dayDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && peerFeedbackIsTodayKst(n.dayDate)
          && n.dayRunId is string && n.dayRunId == n.get('lastRunId', '')
          && n.dayCorrect is int && n.dayCorrect >= 0 && n.dayCorrect <= n.best
          && n.dayBong is int && n.dayBong >= 0 && n.dayBong <= 20
          && n.dayBong * 10 <= n.dayCorrect);
    }

    function oxEntryWriteOk(sid) {
      let n = request.resource.data;
      let o = resource == null ? {} : resource.data;
      return sid.matches('^[A-Za-z0-9_-]{1,24}$')
        && n.keys().hasOnly(['name', 'best', 'bestMs', 'bestAt', 'plays', 'lastRunId', 'dayDate', 'dayRunId',
          'dayCorrect', 'dayBong', 'dayPaidAt', 'updatedAt'])
        && n.get('name', '') is string && n.get('name', '').size() <= 24
        && n.best is int && n.best >= 0 && n.best <= 2000
        && n.get('bestMs', 0) is int && n.get('bestMs', 0) >= 0
        && n.plays is int && n.plays >= o.get('plays', 0) && n.plays <= o.get('plays', 0) + 1
        && n.get('lastRunId', '') is string && n.get('lastRunId', '').size() <= 40
        && n.get('dayRunId', '') is string && n.get('dayRunId', '').size() <= 40
        && (n.best > o.get('best', -1)
          || (n.best == o.get('best', -1) && n.get('bestMs', 0) <= o.get('bestMs', 0)))
        && oxEntryDayOk(n, o);
    }

    // 학생 화면 랭킹 공개 설정 하나(oxQuizBank/challengeBoard). 마스터도 익명 로그인이라 '선생님만'은 가르지 못해요.
    function oxBoardSettingsOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(['rankScope', 'updatedAt'])
        && d.rankScope in ['top5', 'off']
        && d.get('updatedAt', 0) is number;
    }

    match /artifacts/{appId}/public/data/oxQuizBank/live {
      allow read: if true;
      allow create, update: if signedIn() && oxLiveWriteOk();
      allow delete: if false;
    }

    match /artifacts/{appId}/public/data/oxQuizBank/live/answers/{sid} {
      allow read: if true;
      allow create, update: if signedIn() && oxAnswerWriteOk(appId, sid);
      allow delete: if false;
    }

    match /artifacts/{appId}/public/data/oxQuizBank/challengeBoard {
      allow read: if true;
      allow create, update: if signedIn() && oxBoardSettingsOk();
      allow delete: if false;
    }

    match /artifacts/{appId}/public/data/oxQuizBank/challengeBoard/entries/{sid} {
      allow read: if true;
      allow create, update: if signedIn() && oxEntryWriteOk(sid);
      allow delete: if false;
    }

    // 받은 추천·비추천 사유함(사유 + 보낸 사람 실명). 공개 와일드카드(public/**) 밖에 둡니다.
    // artifacts/{학급}/peerFeedback/{받은학번}/items/{날짜_종류_보낸학번} 항목 하나씩 만들기(create)만 됩니다.
    // 고치기·지우기는 막아서 기존 항목은 그대로 남고, 같은 사람이 같은 날 같은 종류를 두 번 쓰지 못합니다.
    // 익명 Auth에는 학번이 없어 '보낸 사람이 정말 그 학번인지'와 '받은 학생 본인만 읽기'는 규칙으로 확인할 수 없습니다.
    // 대신 쓴 사람의 uid를 항목에 남기게 해(위장 추적용) 로그인 없이는 읽지 못하게 합니다.
    // 항목 날짜는 서버 시각(request.time) 기준 한국 날짜(KST) '오늘'만 허용합니다. 미래·과거 날짜로 하루 1회 제한을 우회하지 못하게 합니다.
    function peerFeedbackIsTodayKst(dateStr) {
      let parts = dateStr.split('-');
      return timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]))
        == (request.time + duration.value(9, 'h')).date();
    }

    function peerFeedbackItemOk(appId, toId, itemId) {
      let d = request.resource.data;
      return toId.matches('^[A-Za-z0-9_-]{1,24}$')
        && d.keys().hasOnly(['kind', 'fromId', 'fromName', 'reason', 'date', 'uid', 'createdAt'])
        && d.keys().hasAll(['kind', 'fromId', 'fromName', 'reason', 'date', 'uid', 'createdAt'])
        && d.kind in ['praise', 'dislike']
        && d.fromId is string && d.fromId.matches('^[A-Za-z0-9_-]{1,24}$')
        && d.fromId != toId
        && d.fromName is string && d.fromName.size() >= 1 && d.fromName.size() <= 24
        && d.reason is string && d.reason.size() >= 1 && d.reason.size() <= 40
        && d.reason.trim().size() >= 1
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && peerFeedbackIsTodayKst(d.date)
        // 보낸 학번·받은 학번 모두 이 학급 학생 목록(public/data/students)에 실제로 있어야 합니다. 가짜 학번 대량 생성 방지.
        && exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/students/$("student_" + d.fromId))
        && exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/students/$("student_" + toId))
        && d.uid == request.auth.uid
        && d.createdAt == request.time
        && itemId == d.date + '_' + d.kind + '_' + d.fromId;
    }

    match /artifacts/{appId}/peerFeedback/{toId} {
      allow read, write: if false;
    }

    // 학습 분석: 퀴즈 레이드가 끝날 때 문항별 정답 기록 한 장. public 와일드카드 밖에 두어 형식을 검사합니다.
    // 문서 ID는 raid_{시작시각}이라 같은 회차를 여러 기기가 저장해도 한 장으로 덮입니다. 지우기는 막습니다.
    function quizResultOk(resultId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'kind', 'startedAt', 'endedAt', 'date', 'questionCount', 'participants', 'questions', 'students'])
        && resultId.matches('^raid_[0-9]{10,16}$')
        && d.id == resultId
        && d.kind == 'quizRaid'
        && d.startedAt is int && 'raid_' + string(d.startedAt) == resultId
        && d.endedAt is int
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.questions is list && d.questions.size() >= 1 && d.questions.size() <= 20
        && d.questionCount == d.questions.size()
        && d.participants is list && d.participants.size() <= 40
        && d.students is map;
    }

    match /artifacts/{appId}/quizResults/{resultId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && quizResultOk(resultId);
      allow delete: if false;
    }

    match /artifacts/{appId}/peerFeedback/{toId}/items/{itemId} {
      allow get: if signedIn();
      // 문서 ID(날짜_종류_보낸학번)를 미리 알 수 없어 사유함 화면은 목록 조회가 꼭 필요합니다. 한 번에 최대 50개만 허용합니다.
      allow list: if signedIn() && request.query.limit != null && request.query.limit <= 50;
      allow create: if signedIn() && peerFeedbackItemOk(appId, toId, itemId);
      allow update, delete: if false;
    }

    // 콘솔 또는 Admin SDK 에서만 만듭니다. 클라이언트 쓰기는 막습니다.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /artifacts/{appId}/public/{document=**} {
      allow read: if true;
      allow write: if signedIn()
        && !isSettingsGlobalDoc()
        && !isAutoXpDoc()
        && !isLearningThermometerDoc()
        && !isLearningThermometerVoteDoc()
        && !isApprovedClassIdDoc()
        && !isOxQuizBankDoc()
        && !isEstateStateDoc()
        && !isAlkkagiLiveDoc()
        && !isBoardGameRoomDoc()
        && studentClassXpSlotAllowed();
    }

    match /classes/{classId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 다른 학급 개설 요청(구 최상위 경로). 실제 문서는
    // artifacts/sambong-class-2026/public/data/classCreateRequests 를 씁니다.
    match /classCreateRequests/{requestId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.status == 'pending';
      allow update: if signedIn();
      allow delete: if false;
    }

    // 초대 코드 → classId O(1) 매핑 (학급별 공유 링크 ?c=CODE)
    match /inviteCodes/{code} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['classId'])
        && request.resource.data.classId is string
        && request.resource.data.classId.size() > 0;
      allow update: if signedIn()
        && request.resource.data.classId is string
        && (
          !('classId' in resource.data)
          || request.resource.data.classId == resource.data.classId
        );
      allow delete: if false;
    }

    // --- ncgame ---
    match /loginByName/{name} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    match /ncgameHofByPack/{packId}/entries/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.packId == packId;
      allow delete: if false;
    }

    // --- PicBook / visual_dictionary ---
    // 삼봉월드 UI·코드에서는 제거됨. 동일 Firebase를 쓰는 PicBook 앱이 별도 규칙 파일을
    // 배포하기 전까지는 접근이 끊기지 않도록 규칙만 유지합니다.
    match /picbook_accounts/{accountKey} {
      allow read, write: if request.auth != null;
    }

    match /picbook_published_timelines/{bookId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /visual_dictionary/{wordId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /visual_dictionary_stories/{storyId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
